# ──────────────────────────────────────────────────────────────────────────
# .htaccess RACINE — à utiliser uniquement si votre hébergeur pointe le
# document root sur la racine du projet (SA/) et non sur SA/public/.
#
# Il fait deux choses :
#   1. Bloque l'accès direct aux dossiers/fichiers qui ne doivent jamais
#      être servis publiquement (src/, templates/, scss/, vendor/, .env, ...).
#   2. Réécrit en interne toute requête restante vers le dossier public/
#      (l'URL affichée au visiteur ne change pas : domaine.fr/contact.php
#      sert bien public/contact.php, domaine.fr/assets/css/style.css sert
#      bien public/assets/css/style.css, etc.)
# ──────────────────────────────────────────────────────────────────────────

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # --- TODO : A décommenter en prod --------------------------------- RewriteBase /

    # --- 1. Dossiers/fichiers jamais accessibles publiquement -------------
    RewriteRule ^(src|templates|scss|vendor|tests|node_modules)(/|$) - [F,L]
    RewriteRule ^\.env(\.example)?$ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|\.gitignore|README\.md)$ - [F,L]

    # --- 2. Tout ce qui n'est pas déjà dans public/ y est redirigé --------
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Sécurité supplémentaire (redondante avec la règle [F] ci-dessus, mais
# garde une protection même si mod_rewrite venait à être désactivé).
<FilesMatch "\.(env|log|md|lock)$">
    Require all denied
</FilesMatch>
